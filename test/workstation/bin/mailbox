#!/usr/bin/env python3
"""Lecture des BAL du fournisseur simulé en IMAPS (certificat vérifié).

Usage :
  mailbox fetch <bal> --match TEXTE [--wait S] [--decrypted]
        premier message contenant TEXTE : message brut (ou, avec --decrypted,
        sa partie déchiffrée)
  mailbox count <bal> [--match TEXTE]            nombre de messages (contenant TEXTE)
  mailbox purge <bal>                            supprime tous les messages

Les messages chiffrés (PGP/MIME) sont déchiffrés avec RNP et les trousseaux du
poste pour cette adresse (~/.rnp/<bal>, archives comprises) : TEXTE est
cherché dans le message brut puis dans sa partie déchiffrée (comme
l'utilisateur la voit dans Thunderbird). Les déchiffrements sont mis en cache
par UID IMAP dans ~/.cache/mailbox.

Variables : IMAP_HOST (provider), IMAP_PORT (993), IMAP_CAFILE (/pki/ca.crt),
MAILBOX_PASSWORD_FILE (/run/secrets/mailbox_password).
Code de sortie : 0 si trouvé, 1 sinon, 2 en cas d'erreur IMAP/TLS.
"""
import argparse
import hashlib
import imaplib
import os
import re
import ssl
import sys
import time

sys.path.insert(0, "/usr/local/lib/workstation")
import wsmail  # noqa: E402

CACHE = os.path.expanduser(os.environ.get("MAILBOX_CACHE", "~/.cache/mailbox"))


def connect(user: str) -> imaplib.IMAP4_SSL:
    host = os.environ.get("IMAP_HOST", "provider")
    port = int(os.environ.get("IMAP_PORT", "993"))
    ctx = ssl.create_default_context(cafile=os.environ.get("IMAP_CAFILE", "/pki/ca.crt"))
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    with open(os.environ.get("MAILBOX_PASSWORD_FILE", "/run/secrets/mailbox_password")) as f:
        password = f.read().strip()
    imap = imaplib.IMAP4_SSL(host, port, ssl_context=ctx, timeout=20)
    imap.login(user, password)
    imap.select("INBOX")
    return imap


def messages(imap: imaplib.IMAP4_SSL):
    """(uidvalidity, uid, message brut) de chaque message."""
    uidvalidity = (imap.response("UIDVALIDITY")[1] or [b"0"])[0].decode()
    _, data = imap.uid("SEARCH", None, "ALL")
    for uid in data[0].split():
        _, parts = imap.uid("FETCH", uid, "(BODY.PEEK[])")
        for item in parts:
            if isinstance(item, tuple):
                yield uidvalidity, uid.decode(), item[1]
                break


def decrypted(user: str, uidvalidity: str, uid: str, raw: bytes) -> bytes | None:
    """Partie déchiffrée d'un message PGP/MIME (cache par UID), None sinon."""
    if b"multipart/encrypted" not in raw:
        return None
    homes = wsmail.homes_for(user)
    tag = hashlib.sha256("|".join(homes).encode()).hexdigest()[:12]
    path = os.path.join(CACHE, user, f"{uidvalidity}-{uid}-{tag}")
    if os.path.exists(path):
        with open(path, "rb") as f:
            data = f.read()
        return data[1:] if data[:1] == b"+" else None
    plain, _ = wsmail.decrypt(raw, homes)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    with open(path, "wb") as f:
        f.write(b"+" + plain if plain is not None else b"-")
    return plain


def matching(user: str, match: str | None) -> list[tuple[bytes, bytes | None]]:
    """[(brut, déchiffré)] des messages contenant `match` (brut ou déchiffré)."""
    imap = connect(user)
    found = []
    try:
        needle = match.encode() if match else None
        for uidvalidity, uid, raw in messages(imap):
            plain = decrypted(user, uidvalidity, uid, raw)
            if needle is None or needle in raw or (plain is not None and needle in plain):
                found.append((raw, plain))
    finally:
        imap.logout()
    return found


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    f = sub.add_parser("fetch")
    f.add_argument("mailbox")
    f.add_argument("--match", required=True)
    f.add_argument("--wait", type=float, default=0)
    f.add_argument("--decrypted", action="store_true")
    c = sub.add_parser("count")
    c.add_argument("mailbox")
    c.add_argument("--match")
    g = sub.add_parser("purge")
    g.add_argument("mailbox")
    a = p.parse_args()
    if not re.fullmatch(r"[a-z0-9._+-]+@[a-z0-9.-]+", a.mailbox):
        print(f"mailbox: adresse invalide : {a.mailbox}", file=sys.stderr)
        return 2

    try:
        if a.cmd == "fetch":
            deadline = time.monotonic() + a.wait
            while True:
                found = matching(a.mailbox, a.match)
                if found:
                    raw, plain = found[0]
                    if a.decrypted:
                        if plain is None:
                            print("mailbox: message trouvé mais non chiffré ou indéchiffrable", file=sys.stderr)
                            return 1
                        sys.stdout.buffer.write(plain)
                    else:
                        sys.stdout.buffer.write(raw)
                    return 0
                if time.monotonic() >= deadline:
                    return 1
                time.sleep(1)
        if a.cmd == "count":
            print(len(matching(a.mailbox, a.match)))
            return 0
        if a.cmd == "purge":
            imap = connect(a.mailbox)
            if imap.search(None, "ALL")[1][0]:
                imap.store("1:*", "+FLAGS", r"(\Deleted)")
                imap.expunge()
            imap.logout()
            return 0
    except (imaplib.IMAP4.error, ssl.SSLError, OSError) as e:
        print(f"mailbox: erreur IMAPS : {e}", file=sys.stderr)
        return 2
    return 2


if __name__ == "__main__":
    sys.exit(main())
