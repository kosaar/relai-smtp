# =============================================================================
#  Configuration du relai SMTP — copier en .env (ignoré par git) et adapter.
#  Les valeurs marquées <À PRÉCISER> sont des EXEMPLES.
#  Les applications autorisées sont dans config/applications.toml (versionné) ;
#  les mots de passe et certificats ne vont PAS ici : voir secrets/README.md.
# =============================================================================

# --- Exposition du relai ---------------------------------------------------------
# IP PRIVÉE de l'hôte Docker (VLAN Services) sur laquelle publier le port de
# soumission 587 (OBLIGATOIRE). <À PRÉCISER>
RELAY_BIND_ADDRESS=10.0.1.5
RELAY_PUBLISHED_PORT=587
# FQDN annoncé par le relai (défaut : relay.<sender_domain de l'inventaire>).
# Le certificat secrets/relay_tls_cert doit couvrir le nom utilisé par les
# applications (ex. smtp-relay.example.com).
#RELAY_HOSTNAME=relay.example.com
# Tentatives d'authentification maximales par IP et par minute.
RELAY_AUTH_RATE_LIMIT=30

# --- Fournisseur cloud (OBLIGATOIRE) ------------------------------------------
# <À PRÉCISER> ex. AWS SES : email-smtp.eu-west-1.amazonaws.com
#              SendGrid : smtp.sendgrid.net — Brevo : smtp-relay.brevo.com
#              Mailjet  : in-v3.mailjet.com
RELAY_HOST=smtp.example-provider.com
# 587 = STARTTLS, 465 = TLS implicite (wrappermode déduit automatiquement)
RELAY_PORT=587
#RELAY_TLS_WRAPPERMODE=auto
# secure = TLS + vérification du certificat (recommandé) ; encrypt = TLS seul
RELAY_TLS_SECURITY_LEVEL=secure
#RELAY_SASL_MECHANISMS=plain, login

# --- Divers --------------------------------------------------------------------
MESSAGE_SIZE_LIMIT=10240000
QUEUE_LIFETIME=5d
TZ=Europe/Paris
RELAY_IMAGE_TAG=2.0.0
