# =============================================================================
#  Configuration du relai SMTP — copier en .env (ignoré par git) et adapter.
#  Les valeurs marquées <À PRÉCISER> sont des EXEMPLES.
#  Les applications autorisées sont dans config/applications.toml (versionné) ;
#  les mots de passe et certificats ne vont PAS ici : voir secrets/README.md.
# =============================================================================

# --- Exposition du relai ---------------------------------------------------------
# IP PRIVÉE de l'hôte Docker (VLAN Services) sur laquelle publier le port de
# soumission 587 (OBLIGATOIRE). <À PRÉCISER>
RELAY_BIND_ADDRESS=10.0.1.5
RELAY_PUBLISHED_PORT=587
# FQDN annoncé par le relai (défaut : relay.<sender_domain de l'inventaire>).
# Le certificat secrets/relay_tls_cert doit couvrir le nom utilisé par les
# applications (ex. smtp-relay.example.com).
#RELAY_HOSTNAME=relay.example.com
# Tentatives d'authentification maximales par IP et par minute.
RELAY_AUTH_RATE_LIMIT=30

# --- Fournisseur cloud (OBLIGATOIRE) ------------------------------------------
# <À PRÉCISER> ex. AWS SES : email-smtp.eu-west-1.amazonaws.com
#              SendGrid : smtp.sendgrid.net — Brevo : smtp-relay.brevo.com
#              Mailjet  : in-v3.mailjet.com
RELAY_HOST=smtp.example-provider.com
# 587 = STARTTLS, 465 = TLS implicite (wrappermode déduit automatiquement)
RELAY_PORT=587
#RELAY_TLS_WRAPPERMODE=auto
# secure = TLS + vérification du certificat (recommandé) ; encrypt = TLS seul
RELAY_TLS_SECURITY_LEVEL=secure
#RELAY_SASL_MECHANISMS=plain, login

# --- Divers --------------------------------------------------------------------
MESSAGE_SIZE_LIMIT=10240000
QUEUE_LIFETIME=5d
TZ=Europe/Paris
RELAY_IMAGE_TAG=2.0.0

# --- Annuaire de clés (keydir) ---------------------------------------------------
# IP PRIVÉE de l'hôte sur laquelle publier l'annuaire HTTPS (postes : dépôt de
# clé, WKD). <À PRÉCISER> Le nom openpgpkey.<domaine> doit y pointer (DNS
# interne) pour que Thunderbird découvre les clés par WKD.
KEYDIR_BIND_ADDRESS=10.0.1.5
KEYDIR_PUBLISHED_PORT=443
# Domaines dont l'annuaire publie les clés (séparés par des espaces).
KEYDIR_DOMAINS=example.com
# Durée de conservation du journal d'audit de l'annuaire (jours).
KEYDIR_AUDIT_RETENTION_DAYS=365
# Clés signalées « proches de l'expiration » dans les métriques (jours).
#KEYDIR_EXPIRY_WARNING_DAYS=30

# --- Passerelle (chiffrement) ------------------------------------------------------
# Durée du cache des clés lues sur l'annuaire (secondes) et objet extérieur des
# messages chiffrés (l'objet réel n'existe plus que dans la partie chiffrée).
#GATEWAY_KEY_CACHE_TTL=300
#GATEWAY_NEUTRAL_SUBJECT=Message chiffré
# Réseau interne relai <-> passerelle <-> annuaire, et adresse fixe de la
# passerelle sur ce réseau (seule autorisée à réinjecter les messages chiffrés).
# À changer seulement si le sous-réseau est déjà utilisé sur l'hôte.
#BACKEND_SUBNET=172.30.53.0/24
#GATEWAY_BACKEND_IP=172.30.53.20

# --- Supervision (exporteur Prometheus du relai, GET /metrics) ---------------------
# IP de l'hôte sur laquelle publier les métriques (défaut : 127.0.0.1, boucle
# locale). Mettre l'IP du VLAN de supervision pour un Prometheus distant, et
# filtrer le port au pare-feu (seul le serveur Prometheus doit l'atteindre).
#RELAY_METRICS_BIND_ADDRESS=127.0.0.1
#RELAY_METRICS_PUBLISHED_PORT=9154
# Intervalle de la sonde TLS du smarthost (secondes).
#RELAY_METRICS_PROBE_INTERVAL=300
