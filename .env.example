# =============================================================================
#  Configuration du relai SMTP — copier en .env (ignoré par git) et adapter.
#  Les valeurs marquées <À PRÉCISER> sont des EXEMPLES.
#  Les identifiants SMTP ne vont PAS ici : voir secrets/README.md.
# =============================================================================

# --- Applications autorisées (OBLIGATOIRE) ------------------------------------
# Une IP d'hôte par application, séparées par des virgules. Pas de CIDR.
# <À PRÉCISER> GitLab = 10.0.1.10, Jenkins = 10.0.1.20
ALLOWED_CLIENT_IPS=10.0.1.10,10.0.1.20
# Alternative/complément rechargeable à chaud (décommenter aussi le volume
# correspondant dans docker-compose.yml) :
#ALLOWED_CLIENT_IPS_FILE=/etc/relay/allowed_clients.txt

# --- Exposition du relai ---------------------------------------------------------
# IP PRIVÉE de l'hôte Docker sur laquelle publier le port SMTP (OBLIGATOIRE).
# <À PRÉCISER>
RELAY_BIND_ADDRESS=10.0.1.5
RELAY_PUBLISHED_PORT=25

# --- Expéditeur (OBLIGATOIRE) -------------------------------------------------
# <À PRÉCISER> domaine et adresse validés chez le fournisseur (SPF/DKIM/DMARC).
SENDER_DOMAIN=example.com
SENDER_ADDRESS=noreply@example.com
# always  : tout message sort avec SENDER_ADDRESS (recommandé)
# foreign : seuls les expéditeurs hors de SENDER_DOMAIN sont réécrits
SENDER_REWRITE_MODE=always
# FQDN annoncé par le relai (défaut : relay.<SENDER_DOMAIN>)
#RELAY_HOSTNAME=relay.example.com

# --- Fournisseur cloud (OBLIGATOIRE) ------------------------------------------
# <À PRÉCISER> ex. AWS SES : email-smtp.eu-west-1.amazonaws.com
#              SendGrid : smtp.sendgrid.net — Brevo : smtp-relay.brevo.com
#              Mailjet  : in-v3.mailjet.com
RELAY_HOST=smtp.example-provider.com
# 587 = STARTTLS, 465 = TLS implicite (wrappermode déduit automatiquement)
RELAY_PORT=587
#RELAY_TLS_WRAPPERMODE=auto
# secure = TLS + vérification du certificat (recommandé) ; encrypt = TLS seul
RELAY_TLS_SECURITY_LEVEL=secure
#RELAY_SASL_MECHANISMS=plain, login

# --- Divers --------------------------------------------------------------------
MESSAGE_SIZE_LIMIT=10240000
QUEUE_LIFETIME=5d
TZ=Europe/Paris
RELAY_IMAGE_TAG=1.0.0
