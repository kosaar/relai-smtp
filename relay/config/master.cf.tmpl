# =============================================================================
#  master.cf — GÉNÉRÉ AU DÉMARRAGE par entrypoint.sh (master.cf.tmpl).
#  Seul le port de soumission 587 est ouvert aux applications (pas de port 25).
#  Pas de chroot (inutile dans un conteneur isolé, et source de pannes DNS/TLS).
#  Chaque transaction acceptée sur le 587 est relayée en temps réel au filtre
#  avant file de la passerelle (smtpd_proxy_filter), qui la chiffre et la
#  réinjecte sur le port de réinjection : seul le message chiffré est écrit
#  dans la file. Le port de réinjection n'écoute que sur l'adresse du réseau
#  backend et n'accepte que l'IP de la passerelle.
#  cleanup accepte un message 50 % plus gros que la limite annoncée aux
#  applications (SIZE, contrôlée par smtpd) : la version chiffrée produite par
#  la passerelle (armure ASCII) est plus volumineuse que l'original.
# =============================================================================
# service     type  private unpriv  chroot  wakeup  maxproc command + args
submission inet  n       -       n       -       -       smtpd
  -o smtpd_proxy_filter=@@RELAY_PROXY_FILTER@@
  -o smtpd_proxy_timeout=180s
@@REINJECT_ADDRESS@@:@@REINJECT_PORT@@ inet n - n - - smtpd
  -o syslog_name=postfix/reinject
  -o smtpd_proxy_filter=
  -o smtpd_milters=
  -o smtpd_tls_security_level=none
  -o smtpd_sasl_auth_enable=no
  -o mynetworks=@@GATEWAY_IP@@/32
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o smtpd_data_restrictions=
  -o smtpd_reject_footer=
  -o message_size_limit=@@QUEUE_SIZE_LIMIT@@
pickup        unix  n       -       n       60      1       pickup
cleanup       unix  n       -       n       -       0       cleanup
  -o message_size_limit=@@QUEUE_SIZE_LIMIT@@
qmgr          unix  n       -       n       300     1       qmgr
tlsmgr        unix  -       -       n       1000?   1       tlsmgr
rewrite       unix  -       -       n       -       -       trivial-rewrite
bounce        unix  -       -       n       -       0       bounce
defer         unix  -       -       n       -       0       bounce
trace         unix  -       -       n       -       0       bounce
verify        unix  -       -       n       -       1       verify
flush         unix  n       -       n       1000?   0       flush
proxymap      unix  -       -       n       -       -       proxymap
proxywrite    unix  -       -       n       -       1       proxymap
smtp          unix  -       -       n       -       -       smtp
relay         unix  -       -       n       -       -       smtp
showq         unix  n       -       n       -       -       showq
error         unix  -       -       n       -       -       error
retry         unix  -       -       n       -       -       error
discard       unix  -       -       n       -       -       discard
anvil         unix  -       -       n       -       1       anvil
scache        unix  -       -       n       -       1       scache
postlog       unix-dgram n  -       n       -       1       postlogd
